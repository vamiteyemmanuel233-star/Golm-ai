# Copy this file to server/.env and add your own key.
# NEVER commit server/.env or paste your key into frontend code.
#
# Get a free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: any text model available to your key in Google AI Studio.
# Free-tier availability changes over time — check https://ai.google.dev/pricing
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional: port for this local server (must match vite.config.ts)
AI_SERVER_PORT=8787
