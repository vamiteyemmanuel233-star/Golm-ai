# GOLM AI — environment variables (example only; never put real keys in this file)
#
# WHERE TO SET THEM
#  • Vercel (live website): Project → Settings → Environment Variables
#  • Your computer (npm run server): copy server/.env.example to server/.env
#
# Required for Live AI Coach. Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional. Any Gemini text model your key can use (check Google AI Studio).
GEMINI_MODEL=gemini-3.5-flash-lite
